# Supabase Configuration
# =====================
# Obtener estas credenciales del dashboard de Supabase
# URL del proyecto
SUPABASE_URL=https://your-project.supabase.co
# Key pública (anon/public) -Esta es segura para exponer en el frontend
SUPABASE_KEY=your-supabase-anon-key
# Service role key - NUNCA subir al repositorio, solo para uso interno del backend
SUPABASE_SERVICE_KEY=your-service-role-key-only-for-backend-use

# JWT Configuration
# =====================
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Server Configuration
# =====================
HOST=0.0.0.0
PORT=3001
DEBUG=true